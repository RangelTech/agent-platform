# Produção VPS (infra-04). Copiar para infra/.env.prod (fora do Git) e
# preencher os valores reais — segue o padrão de secrets do vps_rt_infra
# (.env fora do Git / secrets/vps-rt-services.json local).

# Banco já está na mesma VPS (vps_rt_infra), sem mudança de host — só ajustar
# credenciais reais.
DATABASE_URL=postgresql://agent:REAL_PASSWORD@postgres:5432/agent_llm
PORT=8090

# Kernel continua no Cloud Run (infra-01) — URL não muda.
KERNEL_URL=https://teste-ia-kernel-xxxx.a.run.app

# CRÍTICO (infra-04): deixar KERNEL_AUDIENCE vazio. Se setado, o backend tenta
# bater no metadata server do GCP, que não existe na VPS, e toda chamada ao
# kernel falha sem fallback silencioso (ver backend/app/gcp_auth.py).
KERNEL_AUDIENCE=

# Shared secret com o kernel — mesmo valor do secret `teste-ia-kernel-internal-token`
# usado no deploy do kernel (infra/deploy.sh). Gerar com `openssl rand -hex 32`.
KERNEL_INTERNAL_TOKEN=

# URL pública deste serviço na VPS (usada no webhook do Mercado Pago).
PUBLIC_BASE_URL=https://ia.rangeltech.net

# Ponte omnichannel (chatwoot-rt/bridge), agora também na VPS.
BRIDGE_URL=https://bridge.rangeltech.net
BRIDGE_ADMIN_TOKEN=

# Storage: já é S3-compatible apontando pro MinIO da própria VPS — mesmo valor
# já usado em produção hoje (infra/deploy.sh), sem migração de código
# necessária (storage.py já prioriza S3 sobre GCS).
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://storage.rangeltech.net
S3_REGION=us-east-1
S3_BUCKET=teste-ia
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=agent-llm
S3_PUBLIC_BASE_URL=https://storage.rangeltech.net/teste-ia
GCS_BUCKET=

# Cloud Tasks: deixar vazio de propósito (infra-04). Sem fila configurada,
# enqueue_kernel_task() cai automaticamente no modo fire-and-forget — correto
# pra um processo persistente na VPS, que não tem a natureza efêmera do Cloud
# Run que o Cloud Tasks existia pra proteger.
CLOUD_TASKS_QUEUE=
TASKS_SERVICE_ACCOUNT=

ENCRYPTION_KEY=
MASTER_EMAIL=
MASTER_PASSWORD=
MASTER_NAME=
