# Dev defaults — copy to .env and adjust. Everything real lives in the database or Secret Manager.
DATABASE_URL=postgresql://agent:agent@localhost:5433/agent_llm
KERNEL_URL=http://localhost:8080

# Shared object storage. Leave STORAGE_BACKEND empty in local dev to keep the
# local shared volume flow from docker-compose, or set STORAGE_BACKEND=s3 to
# test against MinIO/S3-compatible storage.
STORAGE_BACKEND=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=agent-llm
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_SECONDS=3600
